# Copy to .env and edit. All values are optional.

# Models (downloaded from Hugging Face on first use, ~4 GB inpaint + ~1.5 GB ControlNet)
INPAINT_MODEL=stable-diffusion-v1-5/stable-diffusion-inpainting
CONTROLNET_MODEL=lllyasviel/control_v11p_sd15_canny
# HF_TOKEN=hf_xxx            # only if a model repo requires login
LOCAL_FILES_ONLY=false        # true = never touch the network (models must already be cached)

# Hardware: auto | cuda | mps | cpu
DEVICE=auto
CPU_OFFLOAD=false             # true = fits in ~4-6 GB VRAM, slower
KEEP_BOTH_MODELS=true         # false = free memory by keeping only one pipeline loaded
ENABLE_CLIP_SCORE=false       # true = adds CLIP prompt-similarity metric (downloads CLIP)

# Images
MAX_IMAGE_SIDE=768            # longest side sent to the model (512-768 recommended for SD 1.5)
MAX_UPLOAD_MB=15

# Generation defaults
DEFAULT_STEPS=30
DEFAULT_GUIDANCE=7.5
DEFAULT_STRENGTH=1.0
DEFAULT_CONTROLNET_SCALE=1.0
MASK_DILATE_PX=4
MASK_FEATHER_PX=8

# Quality-control thresholds (starting values - calibrate on your own images)
QC_MIN_OUTSIDE_SSIM=0.80
QC_MIN_EDGE_F1=0.50
QC_MIN_INSIDE_CHANGE=0.04
QC_MIN_HALO_SSIM=0.80

# Storage
# TRIMVARIANT_DATA_DIR=data/runtime
