{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TrimVariant: run server (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "TrimVariant: CLI report",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/cli.py",
      "args": ["report", "--out", "report.md", "--csv", "variants.csv"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
